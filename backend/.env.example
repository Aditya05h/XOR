AO02_APP_NAME=XOR Capacity Observatory
AO02_ENVIRONMENT=development
# Private provider configuration. Integrations arrive in milestone 3.
AO02_LLM_PROVIDER=deterministic
AO02_OPENAI_API_KEY=
AO02_GEMINI_API_KEY=
# JSON array. Vite proxies /api locally; CORS is only for direct browser access.
AO02_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Server-managed local development credentials; empty denies protected access.
# AO02_AUTH_TOKENS={"<random-secret>":{"role":"operator"}}
# AO02_DATABASE_PATH=D:/XOR/backend/incidents.sqlite3

# Integrated prototype additions
AO02_DEMO_MODE=false
AO02_OPENAI_MODEL=gpt-4.1-mini
AO02_GEMINI_MODEL=gemini-2.5-flash
